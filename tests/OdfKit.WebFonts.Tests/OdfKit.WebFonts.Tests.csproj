    <ProjectReference Include="..\..\OdfKit.WebFonts.Worker\OdfKit.WebFonts.Worker.csproj" />
    <ProjectReference Include="..\..\OdfKit.Extensions.Html.WebFonts\OdfKit.Extensions.Html.WebFonts.csproj" />
    <ProjectReference Include="..\..\OdfKit.WebFonts.Hosting.AspNetCore\OdfKit.WebFonts.Hosting.AspNetCore.csproj" />
    <ProjectReference Include="..\..\OdfKit.WebFonts.OpenType\OdfKit.WebFonts.OpenType.csproj" />
    <ProjectReference Include="..\..\OdfKit.WebFonts.Sidecar\OdfKit.WebFonts.Sidecar.csproj" />
