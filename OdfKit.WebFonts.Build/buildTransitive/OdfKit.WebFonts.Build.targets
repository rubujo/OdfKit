<Project>
  <PropertyGroup>
    <OdfKitWebFontsToolAssembly>$(MSBuildThisFileDirectory)..\tools\net10.0\any\OdfKit.WebFonts.Build.dll</OdfKitWebFontsToolAssembly>
    <OdfKitWebFontsOutputDirectory Condition="'$(OdfKitWebFontsOutputDirectory)' == ''">$(PublishDir)wwwroot\_odf-fonts</OdfKitWebFontsOutputDirectory>
    <OdfKitWebFontsProfile Condition="'$(OdfKitWebFontsProfile)' == ''">default</OdfKitWebFontsProfile>
    <OdfKitWebFontsFormats Condition="'$(OdfKitWebFontsFormats)' == ''">woff2</OdfKitWebFontsFormats>
    <OdfKitWebFontsBrowserTargets Condition="'$(OdfKitWebFontsBrowserTargets)' == ''"></OdfKitWebFontsBrowserTargets>
  </PropertyGroup>
  <Target Name="OdfKitBuildWebFonts"
          BeforeTargets="PrepareForPublish"
          Condition="'$(OdfKitWebFontsEnabled)' == 'true'">
    <Error Condition="'$(OdfKitWebFontsArguments)' == '' and '$(OdfKitWebFontsFontPath)' == '' and '$(OdfKitWebFontsEudcCodePage)' == ''"
           Text="Set OdfKitWebFontsFontPath, OdfKitWebFontsEudcCodePage, or OdfKitWebFontsArguments when OdfKitWebFontsEnabled is true." />
    <Error Condition="'$(OdfKitWebFontsArguments)' == '' and '$(OdfKitWebFontsFontPath)' != '' and '$(OdfKitWebFontsEudcCodePage)' != ''"
           Text="Set only one of OdfKitWebFontsFontPath and OdfKitWebFontsEudcCodePage." />
    <Error Condition="'$(OdfKitWebFontsArguments)' == '' and '$(OdfKitWebFontsContentRoot)' == ''"
           Text="Set OdfKitWebFontsContentRoot or OdfKitWebFontsArguments when OdfKitWebFontsEnabled is true." />
    <Exec Condition="'$(OdfKitWebFontsArguments)' != ''"
          Command="dotnet &quot;$(OdfKitWebFontsToolAssembly)&quot; build $(OdfKitWebFontsArguments)" />
    <Exec Condition="'$(OdfKitWebFontsArguments)' == ''"
          Command="dotnet &quot;$(OdfKitWebFontsToolAssembly)&quot; build $(OdfKitWebFontsSourceArguments) --content-root &quot;$(OdfKitWebFontsContentRoot)&quot; --output &quot;$(OdfKitWebFontsOutputDirectory)&quot; --profile &quot;$(OdfKitWebFontsProfile)&quot; --formats &quot;$(OdfKitWebFontsFormats)&quot; --browser-targets &quot;$(OdfKitWebFontsBrowserTargets)&quot; $(OdfKitWebFontsAdditionalArguments)" />
  </Target>
  <PropertyGroup>
    <OdfKitWebFontsSourceArguments Condition="'$(OdfKitWebFontsFontPath)' != ''">--font &quot;$(OdfKitWebFontsFontPath)&quot;</OdfKitWebFontsSourceArguments>
    <OdfKitWebFontsSourceArguments Condition="'$(OdfKitWebFontsFontPath)' == '' and '$(OdfKitWebFontsEudcTypeface)' == ''">--eudc-code-page &quot;$(OdfKitWebFontsEudcCodePage)&quot;</OdfKitWebFontsSourceArguments>
    <OdfKitWebFontsSourceArguments Condition="'$(OdfKitWebFontsFontPath)' == '' and '$(OdfKitWebFontsEudcTypeface)' != ''">--eudc-code-page &quot;$(OdfKitWebFontsEudcCodePage)&quot; --eudc-typeface &quot;$(OdfKitWebFontsEudcTypeface)&quot;</OdfKitWebFontsSourceArguments>
  </PropertyGroup>
</Project>
