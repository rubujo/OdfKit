<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    明確鎖定還原來源，避免依賴混淆（不同機器上 machine-wide／user-wide 設定可能解析到
    非預期來源）。<clear /> 會捨棄任何繼承自上層設定的套件來源，只保留本檔明確列出的
    來源；packageSourceMapping 啟用後即為白名單語意——任何未被 pattern 涵蓋的套件會
    還原失敗，因此以萬用字元 "*" 對應到本 repo 目前唯一使用的 nuget.org 來源，涵蓋全部
    套件（見 eng/Test-NuGetPack.ps1、eng/Test-WebFontPackageConsumer.ps1 內另建的臨時
    NuGet.Config 屬於獨立還原情境，不受本檔影響）。

    參考：
    - https://learn.microsoft.com/en-us/nuget/reference/nuget-config-file
    - https://learn.microsoft.com/en-us/nuget/consume-packages/package-source-mapping
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
