{
  "metadata": [
    {
      "src": [
        { "src": "..", "files": ["OdfKit/bin/Release/net10.0/OdfKit.dll", "OdfKit.Extensions.Collaboration/bin/Release/net10.0/OdfKit.Extensions.Collaboration.dll", "OdfKit.Extensions.Html/bin/Release/net10.0/OdfKit.Extensions.Html.dll", "OdfKit.Extensions.Imaging/bin/Release/net10.0/OdfKit.Extensions.Imaging.dll", "OdfKit.Extensions.Ooxml/bin/Release/net10.0/OdfKit.Extensions.Ooxml.dll", "OdfKit.Extensions.Pdf/bin/Release/net10.0/OdfKit.Extensions.Pdf.dll", "OdfKit.Extensions.Rdf/bin/Release/net10.0/OdfKit.Extensions.Rdf.dll", "OdfKit.Extensions.Rendering/bin/Release/net10.0/OdfKit.Extensions.Rendering.dll"] }
      ],
      "properties": { "TargetFramework": "net10.0", "Configuration": "Release" },
      "filter": "filterConfig.yml",
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      { "files": ["toc.yml", "index.md"] },
      { "files": ["api/**.yml"] },
      { "files": ["articles/**.md", "articles/**/toc.yml"] },
      { "files": ["zh-TW/**.{md,yml}", "en/**.{md,yml}", "cs/**.{md,yml}", "da/**.{md,yml}", "de/**.{md,yml}", "es/**.{md,yml}", "fr/**.{md,yml}", "it/**.{md,yml}", "ja/**.{md,yml}", "ko/**.{md,yml}", "ms/**.{md,yml}", "nb/**.{md,yml}", "nl/**.{md,yml}", "pl/**.{md,yml}", "pt/**.{md,yml}", "pt-BR/**.{md,yml}", "sk/**.{md,yml}"] },
      { "src": "../docs", "files": ["ip-compliance.md", "security-limits.md", "evidence-index.md"], "dest": "project-docs" },
      { "src": "..", "files": ["THIRD-PARTY-NOTICES.md"], "dest": "project-docs" }
    ],
    "globalMetadata": {
      "_appName": "OdfKit API Reference",
      "_appTitle": "OdfKit API Reference",
      "_enableSearch": true,
      "_disableContribution": true,
      "_lang": "zh-TW",
      "_appFooter": "OdfKit · <a href=\"/OdfKit/index.html\">語言 / Languages</a> · CC0-1.0"
    },
    "fileMetadata": {
      "_lang": {
        "zh-TW/**": "zh-TW",
        "en/**": "en",
        "cs/**": "cs",
        "da/**": "da",
        "de/**": "de",
        "es/**": "es",
        "fr/**": "fr",
        "it/**": "it",
        "ja/**": "ja",
        "ko/**": "ko",
        "ms/**": "ms",
        "nb/**": "nb",
        "nl/**": "nl",
        "pl/**": "pl",
        "pt/**": "pt",
        "pt-BR/**": "pt-BR",
        "sk/**": "sk"
      }
    },
    "sitemap": {
      "baseUrl": "https://rubujo.github.io/OdfKit/",
      "changefreq": "weekly",
      "priority": 0.5
    },
    "template": ["default", "modern"],
    "output": "../artifacts/api-site",
    "xref": []
  }
}
