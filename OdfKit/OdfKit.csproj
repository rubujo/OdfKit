<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\eng\OdfKit.Package.props" />

  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <PackageId>OdfKit</PackageId>
    <Description>A managed, high-performance ODF (OpenDocument Format) processing library for .NET. / 適用於 .NET 的受控高效能 ODF（OpenDocument Format）處理程式庫。</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ODF;OpenDocument;ODT;ODS;ODP;ODG</PackageTags>
    <RootNamespace>OdfKit</RootNamespace>
    <AssemblyName>OdfKit</AssemblyName>
    <!-- CSharpMath 1.0.0-pre.1 由 eng/Test-NuGetPack.ps1 明確允許。 -->
    <NoWarn>$(NoWarn);NU5104</NoWarn>
    <!-- 產生／更新 PublicAPI 基線時可設 ODFKIT_PUBLICAPI_BASELINE=1，
         讓 RS0016/RS0017 暫不視為錯誤以便 code fix 寫入 Unshipped.txt。
         日常 CI 請勿設定；詳見 PublicAPI/README.md 與 eng/Generate-PublicApiBaseline.ps1。 -->
    <WarningsNotAsErrors Condition="'$(ODFKIT_PUBLICAPI_BASELINE)' == '1'">$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">
    <IsTrimmable>true</IsTrimmable>
    <!-- 裁剪相容性已由 eng/Test-TrimSmoke.ps1 的實機發佈+執行驗證把關；此分析器須對本專案
         619 個檔案、約 28.7 萬行生成碼（DOM/Generated 606 檔 69,841 行；
         Compliance/Generated 13 檔 217,523 行；合計佔本專案 .cs 的 62%）做資料流分析，
         耗時完全不可用，故關閉。

         2026-07-26 實測（Release／net10.0／-t:Rebuild／UseSharedCompilation=false，
         獨立 git worktree 避免與其他建置互相污染）：
           關閉：35.7 秒完成，csc 工作集峰值 2,098 MB
           開啟：連續執行 4 小時 21 分（36,054 CPU 秒）仍未完成而被中止，
                 csc 工作集峰值 2,520 MB，全程無成長趨勢

         結論：記憶體不再是問題（僅 +20%，遠低於本註解舊版所述的「7GB+」——該數字量測於
         OdfKit/DOM/Generated/GeneratedDomWrappers.g.cs 單一巨檔時期，該檔已於
         commit 09640fb5 拆為 606 個獨立檔案，舊量測條件已不存在）。真正的阻礙是耗時：
         已達基準線 400 倍以上，而 CI maintainability job 的 timeout-minutes 僅 10 分鐘。
         若日後要重新開啟，須先解決的是耗時，不是記憶體。 -->
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- 通用套件參照 -->
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="CommunityToolkit.HighPerformance" />
    <PackageReference Include="CSharpMath" />
    <PackageReference Include="System.Security.Cryptography.Xml" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Sylvan.Data.Csv" />
    <!-- 業界公開 API 凍結慣例（Microsoft.CodeAnalysis.PublicApiAnalyzers 最新穩定版）：
         .NET 執行階段／Azure SDK／Roslyn 等同款。變更公開表面時須更新 PublicAPI.*.txt。 -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 雙 TFM 各自一份 API 基線（官方建議：Conditional API Differences 按 TargetFramework 分目錄） -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- .NET 10.0 特定套件參照 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="System.Numerics.Tensors" />
    <PackageReference Include="System.IO.Hashing" />
  </ItemGroup>

  <!-- .NET Standard 2.0 特定套件參照 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Threading.Tasks.Extensions" />
    <PackageReference Include="System.Threading.Channels" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
    <PackageReference Include="Microsoft.Bcl.HashCode" />
    <PackageReference Include="System.Text.Encoding.CodePages" />
  </ItemGroup>

</Project>
