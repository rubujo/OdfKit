# Auto-detect text files and perform LF normalization
* text=auto

# Source code files - force CRLF line endings on checkout for Windows compatibility in VS 2026
*.cs text eol=crlf
*.csproj text eol=crlf
*.sln text eol=crlf
*.slnx text eol=crlf
*.ps1 text eol=crlf
*.config text eol=crlf
*.xml text eol=crlf
*.json text eol=crlf

# Documentation files
*.md text eol=crlf
*.txt text eol=crlf
LICENSE text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.dll binary
*.exe binary

# 逐位元組保留 OASIS 官方 schema，包括來源中的行尾空白。
tools/OdfSchemaGenerator/schemas/OpenDocument-schema-v1.0-os.rng -text whitespace=-blank-at-eol
