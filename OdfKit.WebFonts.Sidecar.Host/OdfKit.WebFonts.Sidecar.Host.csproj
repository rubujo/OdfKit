<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IsPackable>false</IsPackable>
    <AssemblyName>OdfKit.WebFonts.Sidecar.Host</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OdfKit.WebFonts.Abstractions\OdfKit.WebFonts.Abstractions.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <GlobalPropertiesToRemove>PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\OdfKit.WebFonts.OpenType\OdfKit.WebFonts.OpenType.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <GlobalPropertiesToRemove>PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\OdfKit.WebFonts.Sidecar.Server\OdfKit.WebFonts.Sidecar.Server.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <GlobalPropertiesToRemove>PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\OdfKit.WebFonts.Worker\OdfKit.WebFonts.Worker.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <GlobalPropertiesToRemove>PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
    <ProjectReference Include="..\OdfKit\OdfKit.csproj">
      <SetTargetFramework>TargetFramework=net10.0</SetTargetFramework>
      <GlobalPropertiesToRemove>PublishAot</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>
</Project>
