<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="OdfKit.WebFonts.AssetRootPath" value="~/App_Data/OdfWebFonts" />
    <add key="OdfKit.WebFonts.PublicBaseUrl" value="/_odf-fonts" />
    <add key="OdfKit.WebFonts.StylesheetFileName" value="webfonts.css" />
    <add key="OdfKit.WebFonts.AllowPublicCrossOriginAssets" value="false" />
    <add key="OdfKit.WebFonts.DynamicConfigurationPath" value="~/App_Data/webfonts.dynamic.json" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
  <system.webServer>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="65536" />
      </requestFiltering>
    </security>
    <handlers>
      <add name="OdfWebFonts" path="_odf-fonts/*" verb="GET,HEAD,POST"
           type="OdfKit.WebFonts.Hosting.SystemWeb.OdfWebFontDynamicHandler, OdfKit.WebFonts.Hosting.SystemWeb"
           resourceType="Unspecified" />
    </handlers>
  </system.webServer>
</configuration>
