<Project>
  <PropertyGroup Condition="'$(OdfKitWebFontAspNetCoreSampleIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$(OdfKitWebFontAspNetCoreSampleIntermediateRoot)</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
