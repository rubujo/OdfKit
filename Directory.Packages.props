<Project>
  <!--
    Central Package Management（CPM）。所有 .csproj 移除內嵌 PackageReference Version，
    版本統一在本檔的 PackageVersion 集中維護，避免同一套件在不同專案漂移出不一致版本。
    參考：https://learn.microsoft.com/en-us/nuget/consume-packages/central-package-management

    注意：
    - tests/OdfKit.NetFramework48Smoke 與 tests/OdfKit.WebFonts.SystemWebSmoke 兩個「消費端
      煙霧測試」專案刻意以 ManagePackageVersionsCentrally=false 退出 CPM——它們模擬外部消費者
      安裝已發佈的 OdfKit.* 套件，版本來自建置時注入的 $(OdfKitPackageVersion)（見
      eng/Test-NetFramework48Smoke.ps1、eng/Test-WebFontPackageConsumer.ps1），不屬於本 repo
      內部相依版本治理範圍。
    - CentralPackageTransitivePinningEnabled 刻意不開啟（維持預設 false），避免改變任何
      現有的可傳遞相依版本解析結果（零行為變更是本次遷移的驗收標準）。
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="AngleSharp" Version="1.7.1" />
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
    <PackageVersion Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="CommunityToolkit.HighPerformance" Version="8.4.2" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <!-- CSharpMath 1.0.0-pre.1 為 prerelease；OdfKit/OdfKit.csproj 的 NoWarn 內含 NU5104 抑制。 -->
    <PackageVersion Include="CSharpMath" Version="1.0.0-pre.1" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="dotNetRdf.Core" Version="3.5.2" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.3.4" />
    <PackageVersion Include="HarfBuzzSharp" Version="14.2.1.2" />
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <PackageVersion Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.11" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.62.0" />
    <PackageVersion Include="Microsoft.Win32.Registry" Version="5.0.0" />
    <PackageVersion Include="MiniExcel" Version="1.45.0" />
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <PackageVersion Include="ScottPlot" Version="5.1.59" />
    <PackageVersion Include="SkiaSharp" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.macOS" Version="4.151.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Win32" Version="4.151.1" />
    <PackageVersion Include="Sylvan.Data.Csv" Version="1.4.4" />
    <PackageVersion Include="System.Buffers" Version="4.6.1" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.10" />
    <PackageVersion Include="System.Memory" Version="4.6.3" />
    <PackageVersion Include="System.Numerics.Tensors" Version="10.0.10" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.10" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
    <PackageVersion Include="System.Text.Encoding.CodePages" Version="10.0.10" />
    <PackageVersion Include="System.Text.Json" Version="10.0.11" />
    <PackageVersion Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
    <PackageVersion Include="System.Threading.Channels" Version="10.0.10" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="3.2.2" />
  </ItemGroup>
</Project>
