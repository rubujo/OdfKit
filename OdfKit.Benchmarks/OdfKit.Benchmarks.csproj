<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>OdfKit.Benchmarks</RootNamespace>
    <AssemblyName>OdfKit.Benchmarks</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="StandardPerformanceWorkloads.cs" />
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    <!-- 下列兩者僅用於 CompetitiveStreamWriteBenchmarks 的跨套件效能對照，兩者皆為 MIT / Apache-2.0 寬鬆授權，
         不會為建置此 repo 之使用者帶來授權負擔；詳見 docs/performance-comparison.md 的授權裁定說明。 -->
    <PackageReference Include="MiniExcel" Version="1.45.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OdfKit.Extensions.Collaboration\OdfKit.Extensions.Collaboration.csproj" />
    <ProjectReference Include="..\OdfKit.Extensions.Html\OdfKit.Extensions.Html.csproj" />
    <ProjectReference Include="..\OdfKit.Extensions.Pdf\OdfKit.Extensions.Pdf.csproj" />
    <ProjectReference Include="..\OdfKit\OdfKit.csproj" />
    <ProjectReference Include="..\tests\OdfKit.PerformanceFixtures\OdfKit.PerformanceFixtures.csproj" />
  </ItemGroup>

</Project>
