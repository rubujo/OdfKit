<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\eng\OdfKit.Package.props" />
  <Import Project="..\eng\OdfKit.WebFonts.Package.props" />
  <PropertyGroup>
    <PackageId>OdfKit.WebFonts.Worker</PackageId>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>Bounded single-flight background worker for isolated OdfKit WebFont generation. / 用於隔離 OdfKit WebFont 產生工作的有界 single-flight 背景 worker。</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\OdfKit.WebFonts.Abstractions\OdfKit.WebFonts.Abstractions.csproj" />
    <ProjectReference Include="..\OdfKit\OdfKit.csproj" />
  </ItemGroup>
</Project>
