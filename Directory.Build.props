<Project>
  <!--
    方案層級建置最佳化（PERF-5e / 建置效能）。
    依據：
    - https://learn.microsoft.com/en-us/visualstudio/code-quality/disable-code-analysis
    - https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/overview
    - https://www.meziantou.net/understanding-the-impact-of-roslyn-analyzers-on-the-build-time.htm
    - https://dev.to/florinvica/9-things-that-silently-kill-your-net-build-time-and-how-to-fix-each-one-3kb4
  -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <UseSharedCompilation>true</UseSharedCompilation>
    <RestoreUseStaticGraphEvaluation>true</RestoreUseStaticGraphEvaluation>

    <!-- 全專案固定採目前 SDK 的建議規則集；是否在 build 執行仍由下方環境條件控制。 -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <!-- 保留各專案的編譯器 warnings-as-errors；新增的整套 CA 規則先作可見診斷，
         明確在 .editorconfig 升為 error 的安全與契約規則仍會阻擋建置。 -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>

    <!-- 本機關閉 build-time analyzer；CI（GitHub Actions / CI 環境變數）維持完整 CA 檢查。 -->
    <RunAnalyzersDuringBuild Condition="'$(GITHUB_ACTIONS)' == 'true' OR '$(CI)' == 'true'">true</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringBuild Condition="'$(GITHUB_ACTIONS)' != 'true' AND '$(CI)' != 'true'">false</RunAnalyzersDuringBuild>
    <RunAnalyzersDuringLiveAnalysis Condition="'$(BuildingInsideVisualStudio)' == 'true'">true</RunAnalyzersDuringLiveAnalysis>

    <!-- CI 產出 binlog 時可檢視 Analyzer Summary（需搭配 /bl）。 -->
    <ReportAnalyzer Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ReportAnalyzer>

    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OdfKit.WebFontSmoke' AND '$(OdfKitWebFontSmokeIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$(OdfKitWebFontSmokeIntermediateRoot)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(OdfKitWebFontSmokeIntermediateRoot)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(OdfKitWebFontSmokeIntermediateRoot)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OdfKit.WebFontWorkerProcessSmoke' AND '$(OdfKitWebFontWorkerProcessSmokeIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$(OdfKitWebFontWorkerProcessSmokeIntermediateRoot)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(OdfKitWebFontWorkerProcessSmokeIntermediateRoot)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(OdfKitWebFontWorkerProcessSmokeIntermediateRoot)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'OdfKit.WebFontFormatMatrix' AND '$(OdfKitWebFontFormatMatrixIntermediateRoot)' != ''">
    <BaseIntermediateOutputPath>$(OdfKitWebFontFormatMatrixIntermediateRoot)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(OdfKitWebFontFormatMatrixIntermediateRoot)$(Configuration)\$(TargetFramework)\</IntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(OdfKitWebFontFormatMatrixIntermediateRoot)</MSBuildProjectExtensionsPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);$(MSBuildProjectDirectory)\obj\**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
